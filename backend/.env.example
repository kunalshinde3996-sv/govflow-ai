# Leave DATABASE_URL empty for zero-setup local dev (in-memory pg-mem).
DATABASE_URL=
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173
SEED_DEMO=true

# GovFlow Assist. Leave ANTHROPIC_API_KEY empty to run in Basic (template) mode.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_RATE_LIMIT=20
